# 本地工具状态与临时构建产物。
# deploy.sh 用的是 `git add -A`，不挡住这些就会被一起提交、推到公开的 GitHub Pages。
.workbuddy-ai/
frontend/.preview*/
frontend/.shots/

# 文章本地预览的临时入口。由 tools/render_algo_article.py 生成内容，
# 走真实的 MarkdownView.vue 渲染，供发布前审阅 —— 看完即删，不入库。
frontend/preview-*.html
frontend/src/preview/

# viz-shot.mjs / 临时拼图脚本的一次性产物，看完即删。
frontend/.shots*/
frontend/.shots-all.mjs

# 基准脚本的临时日志目录（tools/bench_*.py 每次运行都会写，别提交）
tools/.bench_observability/

# 临时探针脚本，用完就删
.scratch/
