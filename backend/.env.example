# ========================================
# Blog backend environment variables
# ========================================
# Copy this file to .env and fill in real values.
# The .env file is auto-loaded by settings.py (no extra pip package needed).

# --- 163 邮箱 SMTP (推荐: 无需特殊设置) ---
# 1. 登录 mail.163.com → 设置 → POP3/SMTP/IMAP
# 2. 开启 SMTP 服务 → 获取"授权码"（不是登录密码！）
# 3. 把授权码填到下面 EMAIL_HOST_PASSWORD
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=你的邮箱@163.com
EMAIL_HOST_PASSWORD=你的SMTP授权码

# --- 其他邮箱参考 ---
# QQ邮箱:   EMAIL_HOST=smtp.qq.com   EMAIL_PORT=587  EMAIL_USE_TLS=True
# Gmail:    EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587  EMAIL_USE_TLS=True (需两步验证+应用密码)

# --- Optional ---
# SITE_URL=https://zhoujungis.github.io
# DEBUG=False
